{
  "name": "agent-pilot",
  "version": "1.2.0",
  "description": "Agent Pilot - Universal AI Agent Browser Controller (Antigravity First)",
  "type": "module",
  "scripts": {
    "test": "node scripts/run_test.mjs scripts/verify_all_features.mjs",
    "test:agent": "node scripts/run_test.mjs scripts/verify_agent_connection.mjs",
    "test:feedback": "node scripts/verify_feedback_system.mjs",
    "test:pinned": "node scripts/run_test.mjs scripts/verify_pinned_regions.mjs",
    "test:annotator": "node scripts/run_test.mjs scripts/verify_annotator_tools.mjs",
    "test:session": "node scripts/run_test.mjs scripts/verify_session_lifecycle.mjs",
    "test:edit-delete": "node scripts/run_test.mjs scripts/verify_feedback_edit_delete.mjs",
    "test:secret": "node scripts/verify_secret_sanitizer.mjs",
    "test:item-schema": "node scripts/verify_feedback_item_xss.mjs",
    "test:color-utils": "node scripts/verify_color_utils.mjs",
    "test:background-api": "node scripts/verify_background_api.mjs",
    "test:recorder": "node --test scripts/verify_recorder_regressions.mjs",
    "test:extension-lifecycle": "node scripts/verify_extension_lifecycle.mjs",
    "test:webmcp": "node scripts/verify_webmcp.mjs",
    "test:pwa": "node scripts/verify_pwa_adapter.mjs",
    "probe:pwa": "node scripts/probe_pwa_protocol.mjs",
    "test:devtools": "node scripts/run_test.mjs scripts/verify_devtools.mjs",
    "test:heap-analysis": "node scripts/verify_heap_analysis.mjs",
    "test:isolation": "node scripts/verify_tab_group_isolation.mjs",
    "test:cli": "go test -race -v ./...",
    "test:launcher": "node scripts/test_launch_test_chrome.mjs && node scripts/test_harness_cleanup.mjs",
    "test:all": "npm run test:cli && npm run test:launcher && npm run test:secret && npm run test:item-schema && npm run test:color-utils && npm run test:background-api && npm run test:recorder && npm run test:extension-lifecycle && npm run test:webmcp && npm run test:pwa && npm run test:isolation && npm run test && npm run test:session && npm run test:agent && npm run test:feedback && npm run test:pinned && npm run test:annotator && npm run test:edit-delete",
    "build:cli": "node scripts/build_cli.mjs",
    "launch:chrome": "node scripts/launch_test_chrome.mjs",
    "server": "./cli/agent-pilot server",
    "lint": "node scripts/lint.mjs",
    "pack": "node scripts/pack_extension.mjs",
    "pack:bundle": "node scripts/pack_bundle.mjs",
    "pack:bundle:ubuntu": "node scripts/pack_bundle.mjs --os ubuntu",
    "pack:bundle:macos": "node scripts/pack_bundle.mjs --os macos",
    "pack:bundle:windows": "node scripts/pack_bundle.mjs --os windows",
    "pack:release": "node scripts/pack_bundle.mjs",
    "export:mcp": "node scripts/export_mcp.mjs",
    "sync:mcp": "npm run export:mcp && npm run sync:agk",
    "sync:agk": "node scripts/sync_agk.mjs"
  },
  "keywords": [
    "browser-control",
    "ai-agent",
    "chrome-extension",
    "antigravity",
    "cdp",
    "mcp"
  ],
  "author": {
    "name": "DNT",
    "url": "https://github.com/ducconit"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ducconit/agent-pilot-extension.git"
  },
  "bugs": {
    "url": "https://github.com/ducconit/agent-pilot-extension/issues"
  },
  "homepage": "https://github.com/ducconit/agent-pilot-extension#readme",
  "dependencies": {
    "lighthouse": "^13.5.0",
    "puppeteer-core": "^25.10.0",
    "ws": "^8.18.0"
  }
}
