{
  "name": "agent-pilot",
  "version": "1.4.0",
  "description": "Agent Pilot - Universal AI Agent Browser Controller (Antigravity First)",
  "type": "module",
  "scripts": {
    "test": "node test/runner.mjs core",
    "test:unit": "node test/runner.mjs unit",
    "test:unit:security": "node test/runner.mjs unit:security",
    "test:unit:core": "node test/runner.mjs unit:core",
    "test:unit:harness": "node test/runner.mjs unit:harness",
    "test:e2e": "node test/runner.mjs core",
    "test:group:core": "node test/runner.mjs core",
    "test:group:bridge": "node test/runner.mjs bridge",
    "test:group:feedback": "node test/runner.mjs feedback",
    "test:group:devtools": "node test/runner.mjs devtools",
    "test:group:protocols": "node test/runner.mjs protocols",
    "test:group:platform": "node test/runner.mjs platform",
    "test:agent": "node test/runner.mjs test/e2e/bridge/agent_connection.test.mjs",
    "test:feedback": "node test/runner.mjs test/e2e/feedback/feedback_system.test.mjs",
    "test:pinned": "node test/runner.mjs test/e2e/feedback/pinned_regions.test.mjs",
    "test:annotator": "node test/runner.mjs test/e2e/feedback/annotator_tools.test.mjs",
    "test:session": "node test/runner.mjs test/e2e/core/session_lifecycle.test.mjs",
    "test:edit-delete": "node test/runner.mjs test/e2e/feedback/feedback_edit_delete.test.mjs",
    "test:secret": "node test/runner.mjs test/unit/security/secret_sanitizer.test.mjs",
    "test:item-schema": "node test/runner.mjs test/unit/security/feedback_item_xss.test.mjs",
    "test:color-utils": "node test/runner.mjs test/unit/core/color_utils.test.mjs",
    "test:background-api": "node test/runner.mjs test/unit/core/background_api.test.mjs",
    "test:recorder": "node test/runner.mjs test/unit/core/recorder_regressions.test.mjs",
    "test:extension-lifecycle": "node test/runner.mjs test/e2e/core/extension_lifecycle.test.mjs",
    "test:webmcp": "node test/runner.mjs test/e2e/protocols/webmcp.test.mjs",
    "test:pwa": "node test/runner.mjs test/e2e/protocols/pwa_adapter.test.mjs",
    "probe:pwa": "node scripts/probe_pwa_protocol.mjs",
    "test:devtools": "node test/runner.mjs test/e2e/devtools/devtools.test.mjs",
    "test:packaged-devtools": "node test/runner.mjs test/e2e/devtools/packaged_devtools.test.mjs",
    "test:heap-analysis": "node test/runner.mjs test/e2e/devtools/heap_analysis.test.mjs",
    "test:artifact": "node test/runner.mjs test/e2e/bridge/live_artifact.test.mjs",
    "test:isolation": "node test/runner.mjs test/e2e/core/tab_group_isolation.test.mjs",
    "test:cli": "go test -race -v ./...",
    "test:powershell": "node test/runner.mjs platform",
    "test:launcher": "node test/unit/harness/launch_chrome.test.mjs && node test/unit/harness/harness_cleanup.test.mjs",
    "test:all": "npm run test:cli && npm run build:cli && npm run test:unit && npm run test:group:core && npm run test:group:bridge && npm run test:group:feedback && npm run test:group:devtools && npm run test:group:protocols && npm run test:group:platform",
    "build:cli": "node scripts/build_cli.mjs",
    "launch:chrome": "node scripts/launch_test_chrome.mjs",
    "server": "./cli/agent-pilot server",
    "lint": "node scripts/lint.mjs",
    "pack": "node scripts/pack_extension.mjs",
    "pack:bundle": "node scripts/pack_bundle.mjs",
    "pack:bundle:ubuntu": "node scripts/pack_bundle.mjs --os ubuntu",
    "pack:bundle:macos": "node scripts/pack_bundle.mjs --os macos",
    "pack:bundle:windows": "node scripts/pack_bundle.mjs --os windows",
    "pack:release": "node scripts/pack_bundle.mjs",
    "export:mcp": "node scripts/export_mcp.mjs",
    "sync:mcp": "npm run export:mcp && npm run sync:agk",
    "sync:agk": "node scripts/sync_agk.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "browser-control",
    "ai-agent",
    "chrome-extension",
    "antigravity",
    "cdp",
    "mcp"
  ],
  "author": {
    "name": "DNT",
    "url": "https://github.com/ducconit"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ducconit/agent-pilot.git"
  },
  "bugs": {
    "url": "https://github.com/ducconit/agent-pilot/issues"
  },
  "homepage": "https://github.com/ducconit/agent-pilot#readme",
  "dependencies": {
    "lighthouse": "^13.5.0",
    "puppeteer-core": "^25.10.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "mermaid": "^11.17.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
