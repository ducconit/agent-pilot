{
  "manifest_version": 3,
  "name": "Agent Pilot - Universal AI Agent Browser Control",
  "version": "1.2.0",
  "version_name": "1.2.0",
  "description": "Cầu nối trực tiếp cho AI Agent (Google Antigravity, Claude, Cursor) điều khiển trình duyệt thời gian thực qua CDP. Element Inspector, Color Picker & Screenshot Suite. Antigravity-First.",
  "author": "DNT (https://github.com/ducconit)",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Agent Pilot (Beta)"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' ws://127.0.0.1:* ws://localhost:* http://127.0.0.1:* http://localhost:*;"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/config.js",
        "content/toast.js",
        "content/lock-shield.js",
        "content/cursor-simulator.js",
        "content/cursor-form.js",
        "content/cursor-wait.js",
        "content/selector-utils.js",
        "content/dom-inspector.js",
        "content/eyedropper.js",
        "content/feedback-studio/constants.js",
        "content/feedback-studio/item-schema.js",
        "content/feedback-studio/state.js",
        "content/feedback-studio/capture-service.js",
        "content/feedback-studio/pinned-overlay.js",
        "content/feedback-studio/hud-toolbar.js",
        "content/feedback-studio/modals.js",
        "content/feedback-studio/selection-modes.js",
        "content/feedback-studio/export-channels.js",
        "content/feedback-studio/index.js",
        "content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["main-world-bridge.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "tabs",
    "tabGroups",
    "debugger",
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "contextMenus",
    "alarms",
    "clipboardWrite",
    "management"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      }
    }
  },
  "host_permissions": [
    "<all_urls>"
  ]
}
