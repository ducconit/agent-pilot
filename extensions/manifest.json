{
  "manifest_version": 3,
  "name": "Agent Pilot (Beta) - AI Browser Controller",
  "version": "1.0.0",
  "version_name": "1.0.0-beta",
  "description": "Universal AI Agent Browser Controller with Virtual Mouse, DevTools Inspector (CDP), Element Inspector, Color Picker & Screenshot Suite. Antigravity-First (Public Beta).",
  "author": "DNT (https://github.com/ducconit)",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Agent Pilot (Beta)"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' ws://127.0.0.1:* ws://localhost:* http://127.0.0.1:* http://localhost:*;"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/toast.js",
        "content/lock-shield.js",
        "content/cursor-simulator.js",
        "content/dom-inspector.js",
        "content/eyedropper.js",
        "content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["main-world-bridge.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "tabs",
    "tabGroups",
    "debugger",
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "contextMenus",
    "alarms",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
