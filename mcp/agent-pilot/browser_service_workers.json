        "type": "boolean"
      },
      "contextId": {
        "description": "Optional isolated context",
        "type": "string"
      },
      "expression": {
        "description": "JavaScript to evaluate in the worker",
        "type": "string"
      },
      "limit": {
        "description": "Maximum captured events, default 100",
        "type": "integer"
      },
      "serviceWorkerId": {
        "description": "ID from the worker list",
        "type": "string"
      }
    },
    "type": "object"
  }
