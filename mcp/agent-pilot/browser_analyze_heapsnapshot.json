      "baseFilePath": { "type": "string", "description": "Earlier snapshot path for compare" },
      "currentFilePath": { "type": "string", "description": "Later snapshot path for compare" },
      "nodeId": { "type": "integer", "description": "Heap node index or V8 node id" },
      "className": { "type": "string" },
      "name": { "type": "string" },
      "nodeType": { "type": "string" },
      "propertyName": { "type": "string" },
      "isDetached": { "type": "boolean" },
      "selfSize": { "type": "string" },
      "maxSelfSize": { "type": "string" },
      "sortBy": { "type": "string", "enum": ["selfSize", "name", "edgeCount"] },
      "pageIdx": { "type": "integer" },
      "pageSize": { "type": "integer" },
      "maxItems": { "type": "integer" },
      "maxDepth": { "type": "integer" },
      "maxNodes": { "type": "integer" },
      "maxSiblings": { "type": "integer" }
    }
  },
