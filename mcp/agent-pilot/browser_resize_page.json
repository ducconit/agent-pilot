{
  "description": "Resize browser page viewport metrics (width, height, deviceScaleFactor, mobile) for responsive testing.",
  "inputSchema": {
    "properties": {
      "contextId": {
        "description": "Optional isolated context; context tab IDs are negative",
        "type": "string"
      },
      "deviceScaleFactor": {
        "description": "Device pixel ratio (default: 1)",
        "type": "number"
      },
      "height": {
        "description": "Viewport height in pixels",
        "type": "integer"
      },
      "mobile": {
        "description": "Whether to emulate mobile screen",
        "type": "boolean"
      },
      "tabId": {
        "description": "Target tab ID",
        "type": "integer"
      },
      "touch": {
        "description": "Enable touch emulation",
        "type": "boolean"
      },
      "width": {
        "description": "Viewport width in pixels",
        "type": "integer"
      }
    },
    "required": [
      "width",
      "height"
    ],
    "type": "object"
  },
